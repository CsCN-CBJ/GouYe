    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.0.0"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.0",
    "happy-dom": "^20.10.2",
    "supertest": "^7.2.2",
